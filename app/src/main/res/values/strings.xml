    <!-- Aviso de acessibilidade (obrigatório pela Play, specs/07) -->
    <string name="disclosure_title">Por que o Vedra usa a Acessibilidade</string>
    <string name="disclosure_body">Para bloquear um app no instante em que ele abre, o Vedra precisa saber qual app está na tela. O Android só oferece isso de forma imediata pelo serviço de Acessibilidade.</string>
    <string name="disclosure_sees">O que o Vedra vê: apenas o nome do app que abriu (ex.: \"WhatsApp\").</string>
    <string name="disclosure_not_sees">O que o Vedra não vê: mensagens, textos, fotos, senhas, toques ou qualquer conteúdo da tela.</string>
    <string name="disclosure_storage">O que é guardado ou enviado: nada. O Vedra não tem acesso à internet.</string>
    <string name="disclosure_off">Você pode desligar quando quiser em Configurações → Acessibilidade.</string>
    <string name="disclosure_accept">Concordo e continuar</string>
    <string name="disclosure_decline">Agora não</string>

